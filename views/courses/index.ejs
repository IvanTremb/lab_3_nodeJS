<%- include('../partials/header', { title: 'Список курсов' }) %>

<div class="page-heading">
    <h2>Список курсов</h2>
    <a class="button" href="/courses/new">Добавить курс</a>
</div>

<form class="filters" action="/courses" method="GET">
    <div class="field">
        <label for="search">Название или преподаватель</label>
        <input id="search" name="search" type="search" value="<%= search %>" placeholder="Введите запрос">
    </div>
    <div class="field">
        <label for="semester">Семестр</label>
        <select id="semester" name="semester">
            <option value="">Все семестры</option>
            <% for (let i = 1; i <= 8; i++) { %>
                <option value="<%= i %>" <%= semester === String(i) ? 'selected' : '' %>><%= i %></option>
            <% } %>
        </select>
    </div>
    <button type="submit">Найти</button>
    <a href="/courses">Сбросить</a>
</form>

<p>Найдено курсов: <%= courses.length %></p>
<% if (courses.length === 0) { %>
    <p class="empty-state">Курсы не найдены</p>
<% } else { %>
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Преподаватель</th>
                    <th>Кредиты</th>
                    <th>Семестр</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                <% courses.forEach(course => { %>
                    <tr>
                        <td><%= course.title %></td>
                        <td><%= course.teacher %></td>
                        <td><%= course.credits %></td>
                        <td><%= course.semester %></td>
                        <td>
                            <div class="actions">
                                <a class="button view" href="/courses/<%= course.id %>">Просмотр</a>
                                <a class="button edit" href="/courses/<%= course.id %>/edit">Изменить</a>
                                <form action="/courses/<%= course.id %>/delete" method="POST" onsubmit="return confirm('Удалить этот курс?')">
                                    <button class="delete" type="submit">Удалить</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
<% } %>

<%- include('../partials/footer') %>
